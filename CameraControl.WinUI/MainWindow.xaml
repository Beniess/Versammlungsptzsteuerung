<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CameraControl_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Versammlungs-Kamerasteuerung">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="OnRootSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <NavigationView x:Name="MainNavigation" PaneDisplayMode="Top"
            IsBackButtonVisible="Collapsed" IsSettingsVisible="False" AlwaysShowHeader="False"
            SelectionChanged="OnNavigationChanged" AutomationProperties.AutomationId="MainNavigation">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Positionen" Tag="positions" AutomationProperties.AutomationId="NavigatePositions" />
                <NavigationViewItem Content="Steuerung" Tag="control" AutomationProperties.AutomationId="NavigateControl" />
                <NavigationViewItem Content="Einstellungen" Tag="settings" AutomationProperties.AutomationId="NavigateSettings" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <CommandBar DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsDynamicOverflowEnabled="False">
                    <AppBarButton x:Name="OpenPreview" Label="Vorschau" Icon="Video" Click="OnPreview"
                        AutomationProperties.AutomationId="OpenPreview" AutomationProperties.Name="Vorschau öffnen" />
                </CommandBar>
            </NavigationView.PaneFooter>
            <ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>
        <StackPanel Grid.Row="1" Margin="8,0,8,8" Spacing="4">
            <TextBlock x:Name="ControlStatus" FontSize="14" TextWrapping="Wrap" MaxLines="2"
                AutomationProperties.AutomationId="ControlStatus" />
            <TextBlock x:Name="OperationMessage" FontSize="14" TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                AutomationProperties.AutomationId="OperationMessage" />
        </StackPanel>
    </Grid>
</Window>
