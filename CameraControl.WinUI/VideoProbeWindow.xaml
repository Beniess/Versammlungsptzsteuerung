<Window
    x:Class="CameraControl_WinUI.VideoProbeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Video-Prüfung — Versammlungs-Kamerasteuerung">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Label="Verbinden" Icon="Play" Click="OnOpen" AutomationProperties.AutomationId="VideoOpen" />
            <AppBarButton Label="Foto aufnehmen" Icon="Camera" Click="OnSnapshot" AutomationProperties.AutomationId="VideoSnapshot" />
            <AppBarButton Label="Stream schließen" Icon="Stop" Click="OnStop" AutomationProperties.AutomationId="VideoStop" />
        </CommandBar>
        <Grid x:Name="VideoHost" Grid.Row="1" />
        <InfoBar x:Name="Status" Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Informational" Message="Vorschau bereit. Der Stream ist geschlossen." />
    </Grid>
</Window>
